# Copy to garage-s3.env and fill in. Consumed by the Ansible role app_secrets,
# which creates the k8s Secret `garage-s3` in namespace `platform`. Both the
# garage Deployment (self-provisions its default key + `ingest-landing` bucket
# from these on first boot) and the ingest Deployment (S3 creds for the
# weather_landing/weather_raw pipelines) read this Secret.
#
# Generate fresh values with:
#   GARAGE_RPC_SECRET:         openssl rand -hex 32          (64 hex chars)
#   GARAGE_DEFAULT_ACCESS_KEY: echo "GK$(openssl rand -hex 12)"  (GK + 24 hex)
#   GARAGE_DEFAULT_SECRET_KEY: openssl rand -hex 32          (64 hex chars)

GARAGE_RPC_SECRET=
GARAGE_DEFAULT_ACCESS_KEY=
GARAGE_DEFAULT_SECRET_KEY=
