# Copy to frost.env and fill in. Consumed by the Ansible role app_secrets, which
# creates the k8s Secret `frost` in namespace `platform` — credentials for the
# met.no Frost API (https://frost.met.no, historical/observational weather).
#
# Get client credentials (self-service) at https://frost.met.no/auth/requestCredentials.html
# Frost uses HTTP Basic auth: client id = username, secret = password. Normal
# (public) data retrieval needs only the client id; the secret is for non-public data.

FROST_CLIENT_ID=
FROST_CLIENT_SECRET=
