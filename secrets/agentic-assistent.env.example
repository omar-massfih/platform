# Copy to agentic-assistent.env and fill in. Sourced by ansible role app_secrets,
# which creates the k8s Secret `agentic-assistent` in namespace `platform`.
# These mirror the app's .env / .env.local on the VM today.
# The daemon has no REST surface, so there is no API_TOKEN — access is the
# TELEGRAM_BOT_TOKEN chat channel (add SLACK_APP_TOKEN + SLACK_BOT_TOKEN for Slack).

DATABASE_URL=
TELEGRAM_BOT_TOKEN=
EMAIL_ADDRESS=
EMAIL_PASSWORD=
CALDAV_OAUTH_CLIENT_ID=
CALDAV_OAUTH_CLIENT_SECRET=
CALDAV_OAUTH_REFRESH_TOKEN=
